        w[7] = cipher_key[31:0];
 
        for (i = NK; i < TOTAL_WORDS; i = i + 1) begin
            temp = w[i-1];
 
            if (i % NK == 0) begin
                // RotWord: rotate left by one byte
                rotated = {temp[23:0], temp[31:24]};
                // SubWord: apply S-box to every byte
                subbed  = { sbox_tbl[rotated[31:24]], sbox_tbl[rotated[23:16]],
