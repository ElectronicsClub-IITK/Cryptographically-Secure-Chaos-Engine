                temp = { sbox_tbl[temp[31:24]], sbox_tbl[temp[23:16]],
                         sbox_tbl[temp[15:8]],  sbox_tbl[temp[7:0]] };
            end
 
            w[i] = w[i-NK] ^ temp;
        end
